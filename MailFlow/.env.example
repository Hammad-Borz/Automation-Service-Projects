# MailFlow configuration
MAILFLOW_DEMO_MODE=true
MAILFLOW_LOG_LEVEL=INFO
MAILFLOW_LOG_FILE=logs/mailflow.log

# IMAP
MAILFLOW_IMAP_HOST=imap.example.com
MAILFLOW_IMAP_PORT=993
MAILFLOW_IMAP_USERNAME=
MAILFLOW_IMAP_PASSWORD=
MAILFLOW_IMAP_FOLDER=INBOX
MAILFLOW_IMAP_USE_SSL=true

# SMTP (real delivery remains disabled in demo mode)
MAILFLOW_SMTP_HOST=smtp.example.com
MAILFLOW_SMTP_PORT=587
MAILFLOW_SMTP_USERNAME=
MAILFLOW_SMTP_PASSWORD=
MAILFLOW_SMTP_FROM_ADDRESS=automation@example.com
MAILFLOW_SMTP_USE_TLS=true

# Optional provider selection for future AI implementations
MAILFLOW_RESPONSE_PROVIDER=demo
MAILFLOW_AI_API_KEY=
